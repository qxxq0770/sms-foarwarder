# 管理端登录名与密码。密码至少 8 位，生产环境建议使用随机长密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 手机转发应用调用 Webhook 时使用的 Bearer Token，至少 32 位。
WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# 使用 README 中的命令生成，必须是有效的 Fernet 密钥。
ENCRYPTION_KEY=replace-with-generated-fernet-key

# 用于签署登录 Cookie，至少 32 位。
SESSION_SECRET=replace-with-a-long-random-session-secret

# 生产环境必须填写外部 HTTPS 地址。
PUBLIC_BASE_URL=https://sms.example.com
COOKIE_SECURE=true
SESSION_HOURS=12
